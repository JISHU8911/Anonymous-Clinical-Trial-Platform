# ===========================================================================
# Anonymous Clinical Trial Platform — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ===========================================================================

# Midnight Network identifier: undeployed | preview | preprod
VITE_NETWORK=undeployed

# Deployed Compact contract address on Midnight Network
VITE_CONTRACT_ADDRESS=dec3b071d373ec575648e0c5dfee659710312616875db1fb6cd84a06c7cc6dd2

# Midnight Proof Server URL (default: local Docker container)
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Midnight Indexer GraphQL URL
VITE_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql

# Midnight Node WebSocket URL
VITE_NODE_URL=ws://127.0.0.1:9944

# Private State Storage Password (for local LevelDB encryption)
PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1
