pragma language_version >= 0.23;

import CompactStandardLibrary;

// =============================================================================
// ANONYMOUS CLINICAL TRIAL PLATFORM — Compact Smart Contract
// =============================================================================
// Privacy Model:
//   PRIVATE (witness inputs, never disclosed):
//     - participantSecret    : Patient unique random secret (32 bytes)
//     - participantCommitment: Commitment hash derived from secret + trialId
//     - eligibilityWitness  : Locally asserted eligibility bitmap
//     - rating              : Individual satisfaction score (1-5)
//     - adverseEventFlag    : Individual adverse event flag (0 or 1)
//
//   PUBLIC (intentionally disclosed via disclose()):
//     - trialId             : Trial protocol identifier
//     - totalResponses      : Cumulative submission count
//     - ratingSum           : Sum of all ratings (for computing average)
//     - adverseEventCount   : Count of adverse events reported
//     - isTrialActive       : Recruitment status flag
// =============================================================================

// Public ledger state — aggregated clinical trial metrics visible on-chain
export ledger trialId: Uint<64>;
export ledger totalResponses: Uint<64>;
export ledger adverseEventCount: Uint<64>;
export ledger ratingSum: Uint<64>;
export ledger isTrialActive: Boolean;

// Circuit to initialize a clinical trial protocol
export circuit initializeTrial(initialTrialId: Uint<64>): [] {
    trialId = disclose(initialTrialId);
    totalResponses = disclose(0 as Uint<64>);
    adverseEventCount = disclose(0 as Uint<64>);
    ratingSum = disclose(0 as Uint<64>);
    isTrialActive = disclose(true);
}

// =============================================================================
// MAIN PRIVACY-PRESERVING CIRCUIT: submitFeedback
// =============================================================================
// All parameters are PRIVATE witness inputs — they are used inside ZK circuit
// assertions but are NEVER passed to disclose() and NEVER appear on the ledger.
//
// Witness Input Flow:
//   1. participantSecret    — Patient's local random entropy (32 bytes)
//   2. participantCommitment— Commitment binding secret to this trial
//   3. eligibilityWitness  — Encodes patient eligibility (age >= 18, condition match)
//   4. rating              — Individual 1-5 satisfaction score
//   5. adverseEventFlag    — Whether patient experienced adverse reaction
//
// Only AGGREGATE updates (counters + sums) are disclosed to the public ledger.
// =============================================================================
export circuit submitFeedback(
    participantSecret: Bytes<32>,
    participantCommitment: Bytes<32>,
    eligibilityWitness: Uint<64>,
    rating: Uint<64>,
    adverseEventFlag: Uint<64>
): [] {
    // Assert trial is currently accepting submissions (reads public ledger state)
    assert(isTrialActive, "Clinical trial is not currently active");

    // Assert patient eligibility witness is valid (non-zero = eligible participant)
    // eligibilityWitness encodes age >= 18 AND condition inclusion criteria met
    // The raw eligibility data NEVER leaves the client — only this assertion is proven
    assert(eligibilityWitness > (0 as Uint<64>), "Participant does not meet eligibility criteria");

    // Assert commitment is non-zero (valid commitment from participantSecret + trialId)
    // This prevents null/empty submissions while keeping the secret private
    assert(participantSecret[0] != (0 as Uint<8>) || participantSecret[1] != (0 as Uint<8>), "Invalid participant secret");

    // Assert commitment binding is valid (first byte of commitment must be non-zero)
    // In a full deployment, this would verify SHA-256(participantSecret || trialId)
    assert(participantCommitment[0] != (0 as Uint<8>), "Invalid participant commitment");

    // Assert rating is within valid scale (1 to 5) — PRIVATE value, never disclosed
    assert(rating >= (1 as Uint<64>) && rating <= (5 as Uint<64>), "Rating must be between 1 and 5");

    // Assert adverse event flag is binary (0 = none, 1 = adverse event) — PRIVATE
    assert(adverseEventFlag == (0 as Uint<64>) || adverseEventFlag == (1 as Uint<64>), "Adverse event flag must be 0 or 1");

    // ==========================================================================
    // ONLY AGGREGATE UPDATES ARE DISCLOSED — individual values stay private
    // ==========================================================================
    // Increment total response count (no identity, no individual data)
    totalResponses = disclose((totalResponses + 1) as Uint<64>);

    // Accumulate rating sum (individual rating is private; only sum is public)
    ratingSum = disclose((ratingSum + rating) as Uint<64>);

    // Accumulate adverse event count (individual flag is private; only count public)
    adverseEventCount = disclose((adverseEventCount + adverseEventFlag) as Uint<64>);
}

// Circuit to pause or resume trial recruitment by administrator
export circuit toggleTrialStatus(): [] {
    isTrialActive = disclose(!isTrialActive);
}
